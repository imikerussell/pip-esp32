# pip-esp32: every secret and setting in one place. Copy to .env and fill in.
# The bridge (your computer) reads .env directly. The firmware gets WIFI_* and BRIDGE_*
# baked in at build time: run `python scripts/gen_secrets.py` to write firmware/main/secrets.h.
# Never commit .env or secrets.h (both are in .gitignore).

# ---------- Fish Audio (the voice) ----------
# https://fish.audio/app/api-keys/
FISH_API_KEY=
# Expressive model that takes [stage directions]. Sent as the header "model: drama-3".
FISH_DRAMA_MODEL=drama-3
# Standard TTS model, for the flat before/after comparison
FISH_STANDARD_MODEL=s2.1-pro-free
# Pip's voice: a reference_id from the Fish voice library, or your own cloned voice
FISH_VOICE_ID=

# ---------- Brain (vision + writing the lines) ----------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Reads your face from the camera and writes the line + stage direction
BRAIN_MODEL=claude-sonnet-5
# Faster fallback if latency hurts
BRAIN_FAST_MODEL=claude-haiku-4-5-20251001

# ---------- YouTube stats (optional) ----------
# Google Cloud console > APIs & Services > Credentials > API key, with YouTube Data API v3 enabled
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# How often the bridge checks views/subs (seconds, minimum 60)
YOUTUBE_POLL_SECONDS=120

# ---------- Wi-Fi (the device joins this; 2.4 GHz only) ----------
WIFI_SSID=
WIFI_PASSWORD=

# ---------- Bridge (the brain server on your computer) ----------
# Your computer's LAN IP, as the device sees it
BRIDGE_HOST=
BRIDGE_PORT=8787
# Shared secret the device sends as X-Pet-Key so nobody else on the LAN can drive it.
# Generate one: python -c "import secrets; print(secrets.token_hex(16))"
BRIDGE_SHARED_SECRET=

# ---------- The pet ----------
PET_NAME=Pip
# Audio the bridge returns to the device: 16-bit mono PCM
AUDIO_SAMPLE_RATE=16000
# Seconds between camera looks while idle
CAMERA_LOOK_SECONDS=8
# Minimum seconds between two spoken reactions (stops Pip talking over itself)
SPEAK_COOLDOWN_SECONDS=6

# ---------- Showtime ----------
# 1 = livelier reactions for filming
SHOWTIME=0
